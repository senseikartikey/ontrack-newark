# Postgres (Supabase) connection string
# Get this from your Supabase project -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# NJ Transit developer portal credentials
# Register at https://developer.njtransit.com/registration/ and request RailData API access.
# The RailData API authenticates with a username/password pair (issued at registration)
# to obtain a bearer token, not a static API key.
NJT_USERNAME=
NJT_PASSWORD=

# NJT RailData API base URL and endpoints.
# NOTE: the exact paths below are best-effort from public references and are NOT yet
# confirmed against the live API reference (only visible after logging into the developer
# portal). Confirm and correct these in ingestion/njt_client.py once registered -- see the
# TODO comments there.
NJT_RAILDATA_BASE_URL=https://raildata.njtransit.com/api

# NWS weather API — no key required, just a descriptive User-Agent per NWS API policy.
WEATHER_USER_AGENT=OnTrackNewark (contact: your-email@example.com)
